# ──────────────────────────────────────────────────────────────────────────────
# SecuriSphere — Environment Variables
# Copy this file to .env and adjust values for your environment.
# Production: every CHANGE_ME must be replaced with a strong unique value.
# ──────────────────────────────────────────────────────────────────────────────

# --- PostgreSQL ---
# Option 1 (recommended for managed DB / cloud): single connection string
# DATABASE_URL=postgresql://user:password@hostname.neon.tech/dbname?sslmode=require
#
# Option 2: individual variables (default for local Docker Compose)
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_USER=securisphere_user
POSTGRES_DB=securisphere_db
POSTGRES_HOST=database
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Optional Redis password for production (leave blank for local docker)
REDIS_PASSWORD=

# --- JWT (REQUIRED — backend will refuse to boot if missing in prod) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_min_32_byte_random_string
JWT_EXPIRATION_HOURS=1

# --- Auth feature flags ---
# Public sign-up endpoint /api/auth/register
ALLOW_PUBLIC_REGISTRATION=1
# Legacy plaintext-password login (auto-upgrades to hash on success).
# NEVER enable in production.
ALLOW_PLAINTEXT_LOGIN=0

# --- Admin bootstrap (seeds first admin if user does not exist) ---
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=

# --- CORS ---
# Comma-separated allowed origins. Use exact origins in production.
# Wildcard "*" only acceptable for local development.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# --- Rate limiting (per-IP defaults) ---
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_ATTACK=5/hour

# --- Discord Notifications ---
DISCORD_WEBHOOK_URL=

# --- Topology Collector ---
TOPOLOGY_REFRESH_INTERVAL=10

# --- Docker Compose ---
COMPOSE_PROJECT_NAME=securisphere

# --- Correlation Engine ---
CORRELATION_WINDOW=900
RISK_DECAY_RATE=5
RISK_DECAY_INTERVAL=60

# --- React Frontend ---
REACT_APP_BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# --- AI Settings (Groq / Hugging Face) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
HF_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- Hardening flags ---
FLASK_ENV=production
ALLOW_LOCALHOST_UPSTREAM=0

# --- Attack console ---
# Mode for /api/attack/run launcher.
#   auto       — pick in-process unless ATTACK_TARGETS_AVAILABLE=1 (default)
#   inprocess  — synthetic event emitter (no target services needed)
#   subprocess — legacy launcher; spawns python -m attacker.scenario_*
#                requires auth-service / api-server / web-app on localhost
ATTACK_MODE=auto
ATTACK_TARGETS_AVAILABLE=0
# When 1, /api/attack/run does not require an admin token.
# Set 1 only for public demo deploys (synthetic events, no real targets).
ATTACK_PUBLIC=0

# --- Web server ---
GUNICORN_WORKERS=1
GUNICORN_WORKER_CLASS=geventwebsocket.gunicorn.workers.GeventWebSocketWorker
GUNICORN_TIMEOUT=120
